@page "/course-registration"

<h3>Course Registration</h3>

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty" aria-label="Close"></button>
        </div>
    }

    <div class="mb-3">
        <label for="studentName" class="form-label">Student Name</label>
        <input type="text" id="studentName" class="form-control" @bind="studentName" />
    </div>

    <div class="mb-3">
        <label for="regNumber" class="form-label">Registration Number</label>
        <input type="text" id="regNumber" class="form-control" @bind="registrationNumber" />
    </div>

    <div class="mb-3">
        <label for="courseCode" class="form-label">Course Code</label>
        <input type="text" id="courseCode" class="form-control" @bind="courseCode" />
    </div>

    <div class="mb-3">
        <label for="courseTitle" class="form-label">Course Title</label>
        <input type="text" id="courseTitle" class="form-control" @bind="courseTitle" />
    </div>

    <div class="mb-3">
        <label for="creditHours" class="form-label">Credit Hours</label>
        <select id="creditHours" class="form-select" @bind="creditHours">
            <option value="0" disabled>-- Select Credit Hours --</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
        </select>
    </div>

    <div class="mb-3">
        <label for="semester" class="form-label">Semester</label>
        <select id="semester" class="form-select" @bind="semester">
            <option value="" disabled>-- Select Semester --</option>
            <option value="1st">1st</option>
            <option value="2nd">2nd</option>
            <option value="3rd">3rd</option>
            <option value="4th">4th</option>
            <option value="5th">5th</option>
            <option value="6th">6th</option>
            <option value="7th">7th</option>
            <option value="8th">8th</option>
        </select>
    </div>

    <button type="button" class="btn btn-primary" @onclick="RegisterCourse">Register Course</button>

    <hr class="my-4" />

    <h4>Registered Courses</h4>

    @if (registeredCourses.Count == 0)
    {
        <p class="text-muted">No courses registered yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered mt-3">
                <thead class="table-dark">
                    <tr>
                        <th>Registration ID</th>
                        <th>Student Name</th>
                        <th>Registration No.</th>
                        <th>Course Code</th>
                        <th>Course Title</th>
                        <th>Credit Hours</th>
                        <th>Semester</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in registeredCourses)
                    {
                        <tr>
                            <td>@course.RegistrationId</td>
                            <td>@course.StudentName</td>
                            <td>@course.RegistrationNumber</td>
                            <td>@course.CourseCode</td>
                            <td>@course.CourseTitle</td>
                            <td>@course.CreditHours</td>
                            <td>@course.Semester</td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" @onclick="() => DeleteCourse(course)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Course> registeredCourses = new List<Course>();

    private string studentName = string.Empty;
    private string registrationNumber = string.Empty;
    private string courseCode = string.Empty;
    private string courseTitle = string.Empty;
    private int creditHours = 0;
    private string semester = string.Empty;

    private int nextRegistrationId = 1;
    private string successMessage = string.Empty;

    private void RegisterCourse()
    {
        Course course = new Course
        {
            RegistrationId = nextRegistrationId++,
            StudentName = studentName,
            RegistrationNumber = registrationNumber,
            CourseCode = courseCode,
            CourseTitle = courseTitle,
            CreditHours = creditHours,
            Semester = semester
        };

        registeredCourses.Add(course);

        successMessage = $"Course '{course.CourseCode} - {course.CourseTitle}' registered successfully for {course.StudentName} (ID: {course.RegistrationId}).";

        ClearForm();
    }

    private void DeleteCourse(Course courseToDelete)
    {
        registeredCourses.Remove(courseToDelete);
    }

    private void ClearForm()
    {
        studentName = string.Empty;
        registrationNumber = string.Empty;
        courseCode = string.Empty;
        courseTitle = string.Empty;
        creditHours = 0;
        semester = string.Empty;
    }
}